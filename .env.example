# ── Local Ollama settings ──────────────────────────────────────────────────
# Model to use for story/character/script generation.
# Must be pulled first: ollama pull llama3.2
# Good alternatives: mistral, llama3.1, gemma2, qwen2.5
LOCAL_MODEL=llama3.2

# Ollama server URL (default when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# ── Phase output directories ───────────────────────────────────────────────
PHASE1_OUTPUT_DIR=outputs
PHASE2_HANDOFF_PATH=outputs/phase1output/phase2_audio_handoff.json
PHASE2_OUTPUT_DIR=outputs/phase2output
